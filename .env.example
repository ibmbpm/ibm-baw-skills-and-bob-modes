# IBM® BAW Skills and Bob Modes — Environment Configuration
#
# Fill in the values below before using BAW skills that connect
# to a live BAW environment.
#
# NEVER commit this file to source control — it is listed in .gitignore.

# Base URL of your BAW server — include the context root if applicable, no trailing slash
# Standalone BAW:  https://baw.example.com:9443
# CP4BA:           https://cpd.example.com/bas
BAW_BASE_URL=<your-baw-url>

# BAW credentials (used by skills that call the BAW REST API)
BAW_USERNAME=<your-baw-username>
BAW_PASSWORD=<your-baw-password>
